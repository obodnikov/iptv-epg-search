{
  "name": "iptv-mcp-servers",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP servers for the IPTV EPG provider: TV Guide and Cinema catalogues",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/**/*.test.ts'",
    "cinema": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/cinema/server.ts --data-dir ~/.iptv-mcp/cinema",
    "tv-guide": "node -e \"console.error('The TV Guide server arrives in phase T3, with its tools.'); process.exit(1)\"",
    "check-real-data": "node scripts/check-real-data.ts",
    "import-real-data": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/import-real-data.ts",
    "embed-real-data": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/embed-real-data.ts",
    "manual-checks": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/manual-checks.ts",
    "import-tv-real-data": "node scripts/import-tv-real-data.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "saxes": "6.0.0",
    "snowball-stemmers": "0.6.0",
    "sqlite-vec": "0.1.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
